{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamecaster Plus",
  "version": "4.6.0",
  "identifier": "com.bornicho.gamecasterplus.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main-dashboard",
        "title": "Gamecaster Plus — Broadcast Obsidian Studio v4.6 Pro",
        "width": 1540,
        "height": 940,
        "minWidth": 1240,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
